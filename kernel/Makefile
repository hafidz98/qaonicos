# mach3/Makefile -- placeholder M1.
# Build penuh (kompilasi MI + link kernel ARM) dikerjakan di M2.
# Lihat README.md untuk mapping include dan flag yang dibutuhkan.
#
#   make probe   -- ulangi probe compile M1 (butuh ~/workspace/mach3-src)

MACH3_SRC ?= $(HOME)/workspace/mach3-src

probe:
	@echo "M1 probe: lihat M1-REPORT.md bagian 4 (sudah terdokumentasi)."
	@test -d $(MACH3_SRC)/kernel || (echo "clone dulu: git clone https://github.com/Prajna/mach $(MACH3_SRC)"; exit 1)
